{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "GEN-FAQ-0AP-SHIELD",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "Can an attack from a Unit with 0 AP destroy an opponent's Shield?"
      },
      "setup": {
        "turn": 3,
        "attacker": { "cardNo": "TST-0AP", "ap": 0, "hp": 3 },
        "defenderShields": [{ "cardNo": "SH-1" }]
      },
      "playLine": [{ "type": "ATTACK_SHIELD", "side": "A", "attackerId": "A-0" }],
      "witness": {},
      "expected": { "legal": true, "defenderShieldCount": 1 }
    },
    {
      "id": "GEN-FAQ-RESTED-BLOCKER",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "Can <Blocker> on a rested Unit be activated?"
      },
      "setup": {
        "turn": 3,
        "attacker": { "cardNo": "TST-ATK", "ap": 3, "hp": 3 },
        "defenderUnits": [{ "cardNo": "TST-BLK", "ap": 2, "hp": 4, "effect": "<Blocker>", "rested": true }],
        "defenderShields": [{ "cardNo": "SH-1" }]
      },
      "playLine": [{ "type": "ATTACK_SHIELD", "side": "A", "attackerId": "A-0" }],
      "witness": {
        "actionSteps": [{ "kind": "BLOCKER", "side": "B", "unitId": "B-0" }]
      },
      "expected": { "legal": false, "reason": "PROHIBITED_BY_CANT" }
    },
    {
      "id": "GEN-FAQ-FIRST-STRIKE-NO-RECIPROCAL",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "As a result of dealing damage first with <First Strike> during the damage step, the enemy Unit is destroyed."
      },
      "setup": {
        "turn": 3,
        "attacker": { "cardNo": "TST-FS", "ap": 4, "hp": 3, "effect": "<First Strike>" },
        "defenderUnits": [{ "cardNo": "TST-EN", "ap": 4, "hp": 3, "rested": true }]
      },
      "playLine": [{ "type": "ATTACK_UNIT", "side": "A", "attackerId": "A-0", "targetId": "B-0" }],
      "witness": {},
      "expected": { "legal": true, "attackerDamage": 0, "defenderUnitCount": 0 }
    },
    {
      "id": "GEN-FAQ-SHIELD-ADD-NO-BURST",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "When a card added to my hand with the effect \"Add 1 of your Shields to your hand\" has a 【Burst】 effect"
      },
      "setup": {
        "turn": 3,
        "activeHand": [
          { "cardNo": "TST-BASE", "type": "BASE", "lv": 1, "cost": 1, "hp": 5, "effect": "【Deploy】Add 1 of your Shields to your hand." }
        ],
        "activeShields": [
          { "cardNo": "TST-BST", "type": "COMMAND", "effect": "【Burst】Draw 1.\n【Main】Draw 1." }
        ],
        "activeDeck": [{ "cardNo": "DK-1" }]
      },
      "playLine": [{ "type": "DEPLOY_BASE", "side": "A", "handIndex": 0 }],
      "witness": {},
      "expected": { "legal": true, "activeHandCount": 1, "activeShieldCount": 0 }
    },
    {
      "id": "GEN-FAQ-NO-LEGAL-TARGET",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "Can I activate an effect or play a card if doing so requires that a target be selected but there are no targets available?"
      },
      "setup": {
        "turn": 3,
        "activeHand": [
          { "cardNo": "TST-RM", "type": "COMMAND", "lv": 1, "cost": 1, "effect": "【Main】Choose 1 enemy Unit that is Lv.2 or lower. Destroy it." }
        ]
      },
      "playLine": [{ "type": "PLAY_COMMAND", "side": "A", "handIndex": 0 }],
      "witness": {},
      "expected": { "legal": false, "reason": "NO_LEGAL_TARGET" }
    },
    {
      "id": "GEN-FAQ-DEPTH-FIRST-INTERRUPT",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "Multiple effects activate at the same time and a new effect activates while they are being resolved."
      },
      "setup": {
        "turn": 3,
        "activeHand": [
          { "cardNo": "TST-SP", "lv": 1, "cost": 1, "effect": "【Deploy】Choose 1 Lv.1 Unit card from your trash. Deploy it.\n【Deploy】Draw 1." }
        ],
        "activeTrash": [
          { "cardNo": "TST-CH", "lv": 1, "cost": 1, "effect": "【Deploy】Draw 1." }
        ],
        "activeDeck": [{ "cardNo": "DK-1" }, { "cardNo": "DK-2" }]
      },
      "playLine": [{ "type": "DEPLOY_UNIT", "side": "A", "handIndex": 0 }],
      "witness": { "triggerOrders": [[0, 1]] },
      "expected": { "legal": true, "triggerOrderIncludes": ["TST-SP", "TST-CH", "TST-SP"] }
    },
    {
      "id": "GEN-FAQ-CANT-DOMINATES",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "If an effect negates another effect, or says it \"can't\" have an effect, how are those effects resolved?"
      },
      "setup": {
        "turn": 3,
        "attacker": { "cardNo": "TST-BLK-CANT", "ap": 3, "hp": 3 },
        "defenderUnits": [
          { "cardNo": "TST-BLK", "ap": 2, "hp": 4, "effect": "<Blocker>", "cantBlock": true }
        ],
        "defenderShields": [{ "cardNo": "SH-1" }]
      },
      "playLine": [{ "type": "ATTACK_SHIELD", "side": "A", "attackerId": "A-0" }],
      "witness": {
        "actionSteps": [{ "kind": "BLOCKER", "side": "B", "unitId": "B-0" }]
      },
      "expected": { "legal": false, "reason": "PROHIBITED_BY_CANT" }
    },
    {
      "id": "GEN-FAQ-SUPPRESSION-BURST-BASE-BOUNDARY",
      "faqRef": {
        "kind": "GENERAL",
        "questionPrefix": "A Shield destroyed by <Suppression> damage is revealed to be a Base card with a 【Burst】 effect."
      },
      "setup": {
        "turn": 3,
        "attacker": { "cardNo": "TST-SUP", "ap": 3, "hp": 4, "effect": "<Suppression>" },
        "defenderShields": [
          { "cardNo": "TST-BB", "type": "BASE", "hp": 5, "effect": "【Burst】Deploy this card.\n【Deploy】Add 1 of your Shields to your hand." },
          { "cardNo": "SH-2" },
          { "cardNo": "SH-3" }
        ]
      },
      "playLine": [{ "type": "ATTACK_SHIELD", "side": "A", "attackerId": "A-0" }],
      "witness": { "burstOrder": [0, 1], "burstAccepts": [true] },
      "expected": { "legal": true, "defenderHandCardNos": ["SH-3"], "defenderShieldCount": 0 }
    },
