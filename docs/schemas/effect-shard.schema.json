{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gundam-card-atlas.local/schemas/effect-shard.schema.json",
  "title": "Gundam Compiled Effect Shard",
  "description": "Schema for data/effects/<SET>.json Effect Shards produced by scripts/compile_effects.ts.",
  "type": "object",
  "required": ["schemaVersion", "setPrefix", "cardCount", "effects"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "setPrefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "cardCount": {
      "type": "integer",
      "minimum": 0
    },
    "effects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CompiledCardEffect"
      }
    }
  },
  "$defs": {
    "CardColor": {
      "type": "string",
      "enum": ["Blue", "Green", "Red", "Purple", "White", "Colorless"]
    },
    "KeywordName": {
      "type": "string",
      "enum": [
        "Repair",
        "Breach",
        "Support",
        "Blocker",
        "First Strike",
        "High-Maneuver",
        "Suppression"
      ]
    },
    "KeywordAbility": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/KeywordName" },
        "value": { "type": ["integer", "null"] }
      }
    },
    "EffectTiming": {
      "type": "string",
      "enum": [
        "DEPLOY",
        "ATTACK",
        "DESTROYED",
        "WHEN_PAIRED",
        "WHEN_LINKED",
        "DURING_PAIR",
        "DURING_LINK",
        "BURST",
        "ACTIVATE_MAIN",
        "ACTIVATE_ACTION",
        "MAIN",
        "ACTION",
        "END_OF_TURN",
        "START_OF_OPPONENT_TURN",
        "WHEN_PLAYING",
        "WHEN_ATTACKED",
        "WHEN_DESTROY_BY_BATTLE",
        "WHEN_DEAL_DAMAGE",
        "WHEN_RECEIVE_DAMAGE",
        "WHEN_RECOVER_HP",
        "WHEN_UNIT_DEPLOYED",
        "WHEN_UNIT_PAIRED",
        "WHEN_UNIT_LINKED",
        "WHEN_UNIT_DESTROYED",
        "WHEN_RESTED",
        "WHEN_BLOCKED",
        "WHEN_PLACE_EX_RESOURCE",
        "WHEN_EXILE_EX_RESOURCE",
        "WHEN_ACTIVATE_COMMAND",
        "WHEN_PAY_EFFECT_COST",
        "WHEN_DRAW",
        "WHEN_AP_REDUCED",
        "WHEN_PLAY_CARD_WITH_EX_RESOURCE",
        "CONTINUOUS"
      ]
    },
    "EffectDuration": {
      "type": "string",
      "enum": ["THIS_TURN", "THIS_BATTLE", "NEXT_TURN", "CONTINUOUS"]
    },
    "PairFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trait": { "type": "string" },
        "color": { "$ref": "#/$defs/CardColor" },
        "lvMin": { "type": "integer" },
        "lvMax": { "type": "integer" }
      }
    },
    "LinkRequirement": {
      "type": "object",
      "required": ["role", "names", "traits", "raw"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["UNIT_REQUIRES_PILOT", "PILOT_MATCHING_UNIT"] },
        "names": { "type": "array", "items": { "type": "string" } },
        "traits": { "type": "array", "items": { "type": "string" } },
        "raw": { "type": "string" }
      }
    },
    "TriggerEvent": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/EffectTiming" },
        "actor": { "type": "string", "enum": ["SELF", "FRIENDLY", "ENEMY", "ANY"] },
        "actorFilter": { "$ref": "#/$defs/TargetSelector" },
        "targetKind": {
          "type": "string",
          "enum": ["UNIT", "SHIELD", "BASE", "ANY_ENEMY_CARD", "EX_RESOURCE", "COMMAND", "CARD"]
        },
        "targetFilter": { "$ref": "#/$defs/TargetSelector" },
        "damageType": { "type": "string", "enum": ["BATTLE", "EFFECT", "ANY"] },
        "whileAttacking": { "type": "boolean" },
        "raw": { "type": "string" }
      }
    },
    "ActivationCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceCost": { "type": "integer" },
        "restSelf": { "type": "boolean" },
        "returnSelfToDeckBottom": { "type": "boolean" },
        "destroySelf": { "type": "boolean" },
        "discardCount": { "type": "integer" },
        "exileFromTrashCount": { "type": "integer" },
        "exileFilter": { "$ref": "#/$defs/TargetSelector" },
        "raw": { "type": "string" }
      }
    },
    "TargetSelector": {
      "type": "object",
      "required": ["owner"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "enum": ["ENEMY", "SELF", "ANY", "ALL_PLAYERS"] },
        "self": { "type": "boolean" },
        "cardType": {
          "type": "string",
          "enum": ["UNIT", "PILOT", "BASE", "COMMAND", "SHIELD", "RESOURCE", "CARD", "EX_RESOURCE", "UNIT_TOKEN"]
        },
        "count": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "enum": ["ALL", "UP_TO"] }
          ]
        },
        "maxCount": { "type": "integer" },
        "countRef": { "type": "string", "enum": ["ENEMY_PLAYERS", "COUNTED_VALUE"] },
        "lvMin": { "type": "integer" },
        "lvMax": { "type": "integer" },
        "lvMaxRef": { "type": "string", "enum": ["SELF_LV", "COUNTED_VALUE"] },
        "lvRank": { "type": "string", "enum": ["LOWEST", "HIGHEST"] },
        "apMin": { "type": "integer" },
        "apMax": { "type": "integer" },
        "apMaxRef": { "type": "string", "enum": ["SELF_AP"] },
        "hpMin": { "type": "integer" },
        "hpMax": { "type": "integer" },
        "hpRank": { "type": "string", "enum": ["LOWEST", "HIGHEST"] },
        "state": { "type": "string", "enum": ["ACTIVE", "RESTED", "DAMAGED"] },
        "trait": { "type": "string" },
        "traits": { "type": "array", "items": { "type": "string" } },
        "color": { "$ref": "#/$defs/CardColor" },
        "notColor": { "$ref": "#/$defs/CardColor" },
        "token": { "type": "boolean" },
        "excludeToken": { "type": "boolean" },
        "linked": { "type": "boolean" },
        "paired": {
          "oneOf": [
            { "type": "boolean" },
            { "const": "NONE" }
          ]
        },
        "keyword": { "$ref": "#/$defs/KeywordName" },
        "hasDestroyedEffect": { "type": "boolean" },
        "nameContains": { "type": "string" },
        "excludeName": { "type": "string" },
        "zone": {
          "type": "string",
          "enum": ["BATTLE_AREA", "TRASH", "HAND", "DECK", "SHIELD", "RESOURCE"]
        },
        "other": { "type": "boolean" }
      }
    },
    "ScaleMetric": {
      "type": "object",
      "required": ["metric"],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "HAND_COUNT",
            "TRASH_COUNT",
            "BOARD_UNIT_COUNT",
            "ENEMY_UNIT_COUNT",
            "ENEMY_PLAYER_COUNT",
            "RESTED_ENEMY_UNIT_COUNT",
            "SELF_DAMAGE",
            "PAID_COST",
            "AFFECTED_COUNT",
            "DRAWN_COUNT"
          ]
        },
        "owner": { "type": "string", "enum": ["SELF", "ENEMY", "ANY"] },
        "cardType": { "type": "string", "enum": ["UNIT", "PILOT", "BASE", "COMMAND", "CARD", "UNIT_TOKEN"] },
        "traits": { "type": "array", "items": { "type": "string" } },
        "nameContains": { "type": "string" },
        "uniqueNames": { "type": "boolean" },
        "rested": { "type": "boolean" }
      }
    },
    "EffectCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "zone"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "DEPLOYED_FROM_ZONE" },
            "zone": { "type": "string", "enum": ["trash", "hand"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "TRASH_COUNT_AT_LEAST" },
            "count": { "type": "integer" },
            "owner": { "type": "string", "enum": ["SELF", "ENEMY"] },
            "color": { "$ref": "#/$defs/CardColor" },
            "trait": { "type": "string" },
            "traits": { "type": "array", "items": { "type": "string" } },
            "cardType": { "type": "string" },
            "nameContains": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "FRIENDLY_BASE_IN_PLAY" },
            "color": { "$ref": "#/$defs/CardColor" },
            "trait": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "minAp"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "SELF_AP_AT_LEAST" },
            "minAp": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "trait"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "UNIT_TRAIT_IS" },
            "trait": { "type": "string" },
            "traits": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "IS_YOUR_TURN" } }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "IS_OPPONENT_TURN" } }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "SELF_RESTED" } }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "DESTROYED_BY_BATTLE" } }
        },
        {
          "type": "object",
          "required": ["kind", "owner", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "UNIT_COUNT_AT_LEAST" },
            "owner": { "type": "string", "enum": ["ENEMY", "SELF", "ANY"] },
            "count": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "DEVELOPMENT_EXILE" },
            "count": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "conditions"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "ALL_OF" },
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/EffectCondition" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "conditions"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "ANY_OF" },
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/EffectCondition" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "condition"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "NOT" },
            "condition": { "$ref": "#/$defs/EffectCondition" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "owner", "cardType"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "BOARD_CARD_COUNT" },
            "owner": { "type": "string", "enum": ["SELF", "ENEMY", "ANY"] },
            "cardType": { "type": "string", "enum": ["UNIT", "PILOT", "BASE", "UNIT_TOKEN"] },
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "other": { "type": "boolean" },
            "rested": { "type": "boolean" },
            "linked": { "type": "boolean" },
            "paired": { "type": "boolean" },
            "pairedPilotLvMax": { "type": "integer" },
            "color": { "$ref": "#/$defs/CardColor" },
            "notColor": { "$ref": "#/$defs/CardColor" },
            "traits": { "type": "array", "items": { "type": "string" } },
            "keyword": { "$ref": "#/$defs/KeywordName" },
            "nameContains": { "type": "string" },
            "lvMin": { "type": "integer" },
            "lvMax": { "type": "integer" },
            "apMax": { "type": "integer" },
            "hasDestroyedEffect": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "SELF_STATE" },
            "color": { "$ref": "#/$defs/CardColor" },
            "traits": { "type": "array", "items": { "type": "string" } },
            "paired": { "type": "boolean" },
            "pairedPilotLvMax": { "type": "integer" },
            "damaged": { "type": "boolean" },
            "hpMin": { "type": "integer" },
            "hpMax": { "type": "integer" },
            "lvMin": { "type": "integer" },
            "lvMax": { "type": "integer" },
            "keyword": { "$ref": "#/$defs/KeywordName" },
            "destroyedBy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner": { "type": "string", "enum": ["SELF", "ENEMY"] },
                "traits": { "type": "array", "items": { "type": "string" } },
                "cardEffect": { "type": "boolean" }
              }
            },
            "attackingTarget": {
              "type": "string",
              "enum": ["ENEMY_UNIT", "ENEMY_PLAYER", "DAMAGED_ENEMY_UNIT"]
            },
            "battlingEnemy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keyword": { "$ref": "#/$defs/KeywordName" },
                "lvMax": { "type": "integer" },
                "damaged": { "type": "boolean" },
                "hasDestroyedEffect": { "type": "boolean" },
                "apMaxRef": { "type": "string", "enum": ["SELF_AP"] }
              }
            },
            "pairedWithUnit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "traits": { "type": "array", "items": { "type": "string" } },
                "nameContains": { "type": "string" },
                "linkNames": { "type": "array", "items": { "type": "string" } },
                "lvMin": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "owner"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "HAND_COUNT" },
            "owner": { "type": "string", "enum": ["SELF", "ENEMY"] },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "owner"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "SHIELD_COUNT" },
            "owner": { "type": "string", "enum": ["SELF", "ENEMY", "ANY"] },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "owner"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "RESOURCE_COUNT" },
            "owner": { "type": "string", "enum": ["SELF", "ENEMY"] },
            "ex": { "type": "boolean" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "minLv"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "PLAYER_LV_AT_LEAST" },
            "minLv": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "ENEMY_PLAYER_COUNT_AT_LEAST" },
            "count": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "event"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "TURN_HISTORY" },
            "event": {
              "type": "string",
              "enum": [
                "ACTIVATED_COMMAND",
                "UNIT_DESTROYED_BY_EFFECT",
                "PAID_EFFECT_COST_AT_LEAST",
                "DRAWN_BY_EFFECT",
                "NO_ENEMY_ATTACKED",
                "PAIRED_UNIT_DESTROYED_ENEMY_BY_BATTLE",
                "FRIENDLY_UNIT_DEPLOYED",
                "SET_RESOURCE_ACTIVE_BY_EFFECT"
              ]
            },
            "traits": { "type": "array", "items": { "type": "string" } },
            "minCost": { "type": "integer" },
            "other": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "EX_RESOURCE_USED_TO_PLAY" } }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "PHASE_AT_START_OF_OPPONENT_TURN" } }
        },
        {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "RAW_CONDITION" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "EffectStep": {
      "oneOf": [
        {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": { "action": { "const": "ADD_SELF_TO_HAND" } }
        },
        {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": { "action": { "const": "DEPLOY_SELF" } }
        },
        {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "ACTIVATE_MAIN_EFFECT" },
            "target": { "$ref": "#/$defs/TargetSelector" },
            "fromDiscard": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["action", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "DESTROY" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "amount", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "DEAL_DAMAGE" },
            "amount": { "type": "integer" },
            "scaleBy": { "$ref": "#/$defs/ScaleMetric" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "delta", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "MODIFY_AP" },
            "delta": { "type": "integer" },
            "scaleBy": { "$ref": "#/$defs/ScaleMetric" },
            "duration": { "$ref": "#/$defs/EffectDuration" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "delta", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "MODIFY_HP" },
            "delta": { "type": "integer" },
            "scaleBy": { "$ref": "#/$defs/ScaleMetric" },
            "duration": { "$ref": "#/$defs/EffectDuration" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "REST" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "SET_ACTIVE" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "FREEZE" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "BOUNCE" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "target"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "RETURN_TO_DECK" },
            "position": { "type": "string", "enum": ["TOP", "BOTTOM", "SHUFFLE"] },
            "shuffle": { "type": "boolean" },
            "target": { "$ref": "#/$defs/TargetSelector" }
          }
        },
        {
          "type": "object",
          "required": ["action", "count"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "DRAW" },
            "count": { "type": "integer" },
            "scaleBy": { "$ref": "#/$defs/ScaleMetric" },
            "bothPlayers": { "type": "boolean" },
            "optional": { "type": "boolean" },
            "targetOwner": { "type": "string", "enum": ["SELF", "ENEMY", "ALL_PLAYERS"] }
          }
        },
        {
          "type": "object",
          "required": ["action", "count"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "DISCARD" },
            "count": { "type": "integer" },
            "scaleBy": { "$ref": "#/$defs/ScaleMetric" },
            "targetOwner": { "type": "string", "enum": ["SELF", "ENEMY", "ALL_PLAYERS"] },
            "target": { "$ref": "#/$defs/TargetSelector" },
            "optional": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["action", "count"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "LOOK_TOP" },
            "count": { "type": "integer" },
            "revealSearch": { "type": "boolean" },
            "trashRest": { "type": "boolean" },
            "trait": { "type": "string" },
            "target": { "$ref": "#/$defs/TargetSelector" },
            "remainderPosition": { "type": "string", "enum": ["TOP", "BOTTOM", "TRASH"] }
          }
        },
        {
          "type": "object",
          "required": ["action", "count"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "REVEAL_TOP" },
            "count": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["action", "count"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "ADD_SHIELD_TO_HAND" },
            "count": { "type": "integer" }
          }
        },
        {
          "type": "object",
